# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database connection string for Prisma
DATABASE_URL="postgresql://health_user:health_password@localhost:5432/healthtrack_db?schema=public"

# NextAuth / JWT Secret
NEXTAUTH_SECRET="super-secret-jwt-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
